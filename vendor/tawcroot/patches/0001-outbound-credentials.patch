 /* Local mirror of struct msghdr (64-bit ABI; matches the kernel's
- * user_msghdr layout). We only touch msg_name / msg_namelen; the iov /
- * control fields are forwarded as the guest gave them. */
+ * user_msghdr layout). iov/payload remain guest-owned; a credential
+ * retry can temporarily repoint msg_control into a private copy. */
 struct tawc_msghdr {
 	uint64_t msg_name;        /* void*  */
 	uint32_t msg_namelen;     /* socklen_t */
 	uint32_t _pad;
 	uint64_t msg_iov;         /* struct iovec* */
 	uint64_t msg_iovlen;
 	uint64_t msg_control;
 	uint64_t msg_controllen;
 	int32_t  msg_flags;
 	uint32_t _pad2;
 };
+_Static_assert(sizeof(struct tawc_msghdr) == 56, "64-bit msghdr ABI");
+_Static_assert(offsetof(struct tawc_msghdr, msg_control) == 32,
+	       "64-bit msghdr control offset");
+
+struct tawc_cmsghdr {
+	uint64_t len;
+	int32_t level;
+	int32_t type;
+};
+_Static_assert(sizeof(struct tawc_cmsghdr) == 16, "64-bit cmsghdr ABI");
+
+/* struct ucred is identical on arm64 and x86_64; PID is not virtualized. */
+struct tawc_ucred {
+	int32_t  pid;
+	uint32_t uid;
+	uint32_t gid;
+};
+_Static_assert(sizeof(struct tawc_ucred) == 12, "ucred ABI is 3 words");
+
+/* An explicit SCM_CREDENTIALS containing the caller's virtual IDs is
+ * rejected by the kernel: virtual root has no Android CAP_SETUID/GID.
+ * Retry only that failed send, substituting our ACTUAL kernel UID/GID
+ * for our own virtual identity. No kernel identity or privilege changes;
+ * the receiving socket still observes the Android app's credentials.
+ *
+ * The common successful sendmsg path incurs no ancillary scan/allocation.
+ * On EPERM, snapshot at most 64 KiB with guarded copy and raw mmap (no
+ * malloc/locks on the SIGSYS stack). Oversized, inaccessible, malformed,
+ * or unrelated control data retains the original error. Never mutate the
+ * guest header/control buffer, including SCM_RIGHTS descriptor numbers.
+ * The private buffer lives through the synchronous retry and is released
+ * on every path. The caller also keeps any translated sockaddr fd alive.
+ * recvmsg remains untrapped; this is deliberately outbound-only. */
+static long sendmsg_with_credentials(long fd, const struct tawc_msghdr *mh,
+				     long flags)
+{
+	long rv = TAWC_RAW(TAWC_SYS_sendmsg, fd, (long)mh, flags, 0, 0, 0);
+	if (rv != TAWC_EPERM || !mh->msg_control ||
+	    mh->msg_controllen < sizeof(struct tawc_cmsghdr) ||
+	    mh->msg_controllen > 65536)
+		return rv;
+
+	size_t size = (size_t)mh->msg_controllen;
+	long mapping = tawc_mmap(0, size,
+		TAWC_MM_PROT_READ | TAWC_MM_PROT_WRITE,
+		TAWC_MM_MAP_PRIVATE | TAWC_MM_MAP_ANON, -1, 0);
+	if ((unsigned long)mapping >= (unsigned long)-4095) return rv;
+	unsigned char *control = (unsigned char *)(uintptr_t)mapping;
+	if (tawc_copy_from_guest(control, size,
+			(const void *)(uintptr_t)mh->msg_control) < 0)
+		goto done;
+
+	tawc_identity identity;
+	tawcroot_identity_get(&identity);
+	int32_t pid = (int32_t)tawc_getpid();
+	uint32_t uid = (uint32_t)tawc_getuid();
+	uint32_t gid = (uint32_t)TAWC_RAW(TAWC_SYS_getgid, 0, 0, 0, 0, 0, 0);
+	int changed = 0;
+	size_t offset = 0;
+	while (size - offset >= sizeof(struct tawc_cmsghdr)) {
+		struct tawc_cmsghdr header;
+		memcpy(&header, control + offset, sizeof header);
+		/* Bounds precede alignment arithmetic, so len + 7 cannot overflow. */
+		if (header.len < sizeof header || header.len > size - offset)
+			goto done;
+		if (header.level == SOL_SOCKET_LEVEL &&
+		    header.type == SCM_CREDENTIALS_TYPE) {
+			if (header.len != sizeof header + sizeof(struct tawc_ucred))
+				goto done;
+			struct tawc_ucred cred;
+			memcpy(&cred, control + offset + sizeof header, sizeof cred);
+			if (cred.pid == pid &&
+			    (cred.uid == identity.ruid || cred.uid == identity.euid ||
+			     cred.uid == identity.suid) &&
+			    (cred.gid == identity.rgid || cred.gid == identity.egid ||
+			     cred.gid == identity.sgid)) {
+				changed |= cred.uid != uid || cred.gid != gid;
+				cred.uid = uid;
+				cred.gid = gid;
+				memcpy(control + offset + sizeof header, &cred, sizeof cred);
+			}
+		}
+		size_t aligned = ((size_t)header.len + 7) & ~(size_t)7;
+		/* The final CMSG need not include its trailing alignment padding. */
+		if (aligned > size - offset) break;
+		offset += aligned;
+	}
+	if (changed) {
+		struct tawc_msghdr retry = *mh;
+		retry.msg_control = (uint64_t)(uintptr_t)control;
+		rv = TAWC_RAW(TAWC_SYS_sendmsg, fd, (long)&retry, flags, 0, 0, 0);
+	}
+done:
+	(void)tawc_munmap(control, size);
+	return rv;
+}
 
 /* sendmsg(fd, msghdr*, flags): the destination sockaddr lives in
  * msg_name. Copy the msghdr, translate msg_name into a stack-local
  * sockaddr, repoint, and re-issue. Same connectionless-client failure
  * mode as sendto. */
 static long sendmsg_native(const tawcroot_syscall_args *args)
 {
 	const void *gmsg = (const void *)(uintptr_t)args->b;
 	if (!gmsg) {
 		return TAWC_RAW(TAWC_SYS_sendmsg, args->a, args->b, args->c,
 				0, 0, 0);
 	}
 	struct tawc_msghdr mh;
 	long e = tawc_copy_from_guest(&mh, sizeof mh, gmsg);
 	if (e < 0) return TAWC_EFAULT;
 	if (mh.msg_name == 0 || mh.msg_namelen == 0) {
-		return TAWC_RAW(TAWC_SYS_sendmsg, args->a, args->b, args->c,
-				0, 0, 0);
+		return sendmsg_with_credentials(args->a, &mh, args->c);
 	}
 	struct tawc_sockaddr_un un_out;
 	long new_addrlen;
 	int close_fd;
 	long t = translate_unix_sockaddr(
 		(const void *)(uintptr_t)mh.msg_name, (long)mh.msg_namelen,
 		&un_out, &new_addrlen, 0, &close_fd);
 	if (t < 0) return t;
 	if (t == 0) {
-		return TAWC_RAW(TAWC_SYS_sendmsg, args->a, args->b, args->c,
-				0, 0, 0);
+		return sendmsg_with_credentials(args->a, &mh, args->c);
 	}
 	/* Repoint a COPY of the msghdr at our translated sockaddr; the
 	 * guest's msghdr stays untouched. */
 	mh.msg_name = (uint64_t)(uintptr_t)&un_out;
 	mh.msg_namelen = (uint32_t)new_addrlen;
-	long rv = TAWC_RAW(TAWC_SYS_sendmsg, args->a, (long)&mh, args->c,
-			   0, 0, 0);
+	long rv = sendmsg_with_credentials(args->a, &mh, args->c);
 	if (close_fd >= 0) tawc_close(close_fd);
 	return rv;
 }
 
 static long handle_sendmsg(const tawcroot_syscall_args *args, ucontext_t *uc)
 {
 	(void)uc;
 	long rv = sendmsg_native(args);
@@ -849,41 +945,33 @@
  * SOCK_CLOEXEC callers. */
 static long handle_accept4(const tawcroot_syscall_args *args, ucontext_t *uc)
 {
 	(void)uc;
