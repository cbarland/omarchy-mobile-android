 #define SO_PEERCRED_OPT 17
+#define SCM_CREDENTIALS_TYPE 2
 #define SOCK_TYPE_MASK  0xf
 #define SOCK_DGRAM_TYPE 2
 
 /* sockaddr_nl layout, mirrored locally for the same reason as
