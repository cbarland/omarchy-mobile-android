+int CAndroidBackend::remove(int id, uint64_t generation) {
+    if (id != 1 || !generation) return -EINVAL; // The phone is the compositor's required anchor.
+    auto& display = m_displays[id];
+    if (generation < display.highWater) return 5;
+    if (display.window && attachWindow && !attachWindow(id, nullptr)) return -EIO;
+    display.highWater = generation;
+    display.generation = generation;
+    display.removed = true;
+    if (display.window) ANativeWindow_release(display.window);
+    display.window = nullptr;
+    display.frameScheduled = false;
+    display.hasPointer = false;
