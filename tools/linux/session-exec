#!/bin/bash
# Android-session adapter for the uwsm-app command handoff used by Omarchy.
# Android owns this session's lifetime; no systemd scope/service is created.
# Keep this directory on PATH only for Android-hosted graphical sessions.
if [[ ${OMAMOBILE_SESSION_HOST:-} != android ]]; then
  echo 'uwsm-app: the Android session adapter requires OMAMOBILE_SESSION_HOST=android' >&2
  exit 69
fi
if [[ ${1:-} == -- ]]; then
  shift
fi
if (( $# == 0 )) || [[ -z $1 || $1 == -* ]]; then
  echo 'uwsm-app: Android supports executable argv handoff only; usage: uwsm-app [--] executable [args...]' >&2
  exit 64
fi
# Preserve Wayland/session-bus environment and Hyprland launch-rule tokens.
# Never interpret argv as shell source or silently discard service options.
exec "$@"
