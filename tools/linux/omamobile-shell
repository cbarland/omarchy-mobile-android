#!/bin/bash
set -euo pipefail

# Android keeps the graphical session alive. Quickshell discovery is useful
# diagnostics, but the shell's own IPC socket is the readiness check.
if [[ ${OMAMOBILE_SESSION_HOST:-} != android ]]; then
  echo 'omamobile-shell: requires an Android-hosted graphical session' >&2
  exit 69
fi
usage() { echo 'Usage: omamobile-shell {status|reload|list}' >&2; exit 64; }

case ${1:-} in
  list)
    shift; (( $# == 0 )) || usage
    exec quickshell list -a -j
    ;;
  reload)
    shift; (( $# == 0 )) || usage
    exec omarchy-shell shell reloadConfig
    ;;
  status)
    shift; (( $# == 0 )) || usage
    discovery=unavailable
    discovery_error=''
    if discovery_output=$(quickshell list -a -j 2>&1); then
      discovery_compact=${discovery_output//[[:space:]]/}
      if [[ -n $discovery_compact && $discovery_compact != '[]' ]]; then
        discovery=available
      else
        discovery=empty
      fi
    else
      discovery_error=$discovery_output
    fi
    if ipc_output=$(omarchy-shell shell ping 2>&1) && [[ $ipc_output == ok ]]; then
      printf 'ipc=ready\ndiscovery=%s\n' "$discovery"
      [[ -z $discovery_error ]] || printf 'discovery_error=%s\n' "$discovery_error"
      exit 0
    fi
    printf 'ipc=unavailable\ndiscovery=%s\n' "$discovery" >&2
    [[ -z $ipc_output ]] || printf '%s\n' "$ipc_output" >&2
    exit 1
    ;;
  *) usage ;;
esac
