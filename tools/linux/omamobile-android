#!/usr/bin/env python3
"""Android applications as real, resizable Wayland clients in the shared Linux.

`omamobile-android list`, `device-state`, `battery-state`, `radio-state`, `display-settings`, `network-settings`,
`bluetooth-settings`, `sync` (desktop entries), or `open PACKAGE`.
The private Unix socket authenticates the app UID; it never listens on TCP.
The initial transport is changed-frame JPEG at <=10 fps. Secure Android
surfaces remain protected. This transport is an integration prototype.
"""
import argparse
import json
import os
from pathlib import Path
import re
import socket
import stat
import struct
import sys
import hashlib
import math
import tempfile
import threading
import time

SOCKET = "/run/omamobile/android.sock"
DEVICE_STATE_KEYS = ("deviceLocked", "interactive", "keyguardLocked")
BATTERY_STATE_KEYS = ("present", "percentage", "plugged", "state")
BATTERY_STATES = {"charging", "discharging", "full", "not-charging", "unknown"}
RADIO_TRANSPORTS = {"wifi", "cellular", "ethernet", "bluetooth", "vpn", "wifi-aware",
                    "lowpan", "usb", "thread", "satellite", "other"}
WIFI_RADIO_STATES = {"enabled", "disabled", "enabling", "disabling", "unsupported", "unknown"}
BLUETOOTH_RADIO_STATES = {"on", "off", "turning-on", "turning-off", "unsupported", "unknown"}
PACKAGE_RE = re.compile(r"[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)+\Z")
LAUNCHER_PREFIX = "omamobile-android-"


def valid_package(value):
    return isinstance(value, str) and PACKAGE_RE.fullmatch(value) is not None


def launcher_body(package, name):
    safe_name = name.replace("\n", " ").replace("\r", " ").replace("\\", "\\\\")
    return ("[Desktop Entry]\nType=Application\nName=" + safe_name + " (Android)\n"
            "Exec=omamobile-android open " + package + "\nIcon=phone\nCategories=Utility;\n").encode()


def launcher_content(package, name):
    body = launcher_body(package, name)
    marker = hashlib.sha256(body).hexdigest().encode()
    return body + b"X-Omamobile-Launcher-SHA256=" + marker + b"\n"


def generated_launcher(package, content):
    if not valid_package(package) or not isinstance(content, bytes) or not content.endswith(b"\n"):
        return False
    marker = b"X-Omamobile-Launcher-SHA256="
    if marker not in content:
        return False
    body, claimed = content.rsplit(marker, 1)
    if not claimed.endswith(b"\n"):
        return False
    claimed = claimed[:-1]
    if hashlib.sha256(body).hexdigest().encode() != claimed:
        return False
    lines = body.split(b"\n")
    return (len(lines) == 7 and lines[0] == b"[Desktop Entry]" and
            lines[1] == b"Type=Application" and lines[2].startswith(b"Name=") and
            lines[2].endswith(b" (Android)") and
            lines[3] == b"Exec=omamobile-android open " + package.encode() and
            lines[4] == b"Icon=phone" and lines[5] == b"Categories=Utility;" and
            lines[6] == b"")


def regular_snapshot(path):
    """Return identity and bytes for a regular non-link candidate."""
    try:
        metadata = path.stat(follow_symlinks=False)
        if not stat.S_ISREG(metadata.st_mode):
            return None
        return (metadata.st_dev, metadata.st_ino, path.read_bytes())
    except FileNotFoundError:
        return None


def unchanged_snapshot(path, snapshot):
    """Revalidate the inspected file immediately before a mutation."""
    current = regular_snapshot(path)
    return current is not None and current == snapshot


def write_new(path, content):
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        return False
    with os.fdopen(fd, "wb") as output:
        output.write(content)
    return True


def replace_owned(path, content, snapshot):
    if not unchanged_snapshot(path, snapshot):
        return False
    fd, temporary = tempfile.mkstemp(prefix=".omamobile-android-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(content)
        if not unchanged_snapshot(path, snapshot):
            return False
        os.replace(temporary, path)
        temporary = None
        return True
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def sync_launchers(apps, applications):
    """Reconcile only adapter-owned launcher files after full input validation."""
    if not isinstance(apps, list):
        raise RuntimeError("Android launcher response is not a list")
    entries = []
    packages = set()
    for app in apps:
        if not isinstance(app, dict) or not valid_package(app.get("package")) or not isinstance(app.get("name"), str):
            raise RuntimeError("Android launcher response contains an invalid app")
        package = app["package"]
        entries.append((package, app["name"]))
        packages.add(package)

    applications.mkdir(parents=True, exist_ok=True)
    for path in applications.glob(LAUNCHER_PREFIX + "*.desktop"):
        package = path.name[len(LAUNCHER_PREFIX):-len(".desktop")]
        if not valid_package(package) or package in packages:
            continue
        snapshot = regular_snapshot(path)
        if snapshot is not None and generated_launcher(package, snapshot[2]) and unchanged_snapshot(path, snapshot):
            path.unlink()

    for package, name in entries:
        path = applications / (LAUNCHER_PREFIX + package + ".desktop")
        content = launcher_content(package, name)
        snapshot = regular_snapshot(path)
        existing = None if snapshot is None else snapshot[2]
        if existing is None and (path.exists() or path.is_symlink()):
            continue
        if existing is None:
            write_new(path, content)
        elif generated_launcher(package, existing):
            replace_owned(path, content, snapshot)
        elif existing == launcher_body(package, name):
            replace_owned(path, content, snapshot)
    return len(entries)


def device_state(reply):
    state = {}
    for key in DEVICE_STATE_KEYS:
        value = reply.get(key)
        if type(value) is not bool:
            raise RuntimeError("Android device state field is not boolean: " + key)
        state[key] = value
    return state


def battery_state(reply):
    if set(reply) - {"ok"} != set(BATTERY_STATE_KEYS) or ("ok" in reply and reply["ok"] is not True):
        raise RuntimeError("Android battery state fields are not exact")
    state = {}
    for key in ("present", "plugged"):
        value = reply[key]
        if value is not None and type(value) is not bool:
            raise RuntimeError("Android battery state field is not boolean or null: " + key)
        state[key] = value
    percentage = reply["percentage"]
    if percentage is not None:
        if type(percentage) not in (int, float) or isinstance(percentage, bool):
            raise RuntimeError("Android battery percentage is not a number or null")
        if not math.isfinite(float(percentage)) or not 0 <= percentage <= 100:
            raise RuntimeError("Android battery percentage is outside 0..100")
    state["percentage"] = percentage
    if type(reply["state"]) is not str or reply["state"] not in BATTERY_STATES:
        raise RuntimeError("Android battery state is invalid")
    state["state"] = reply["state"]
    return state


def radio_state(reply):
    if (not isinstance(reply, dict) or set(reply) != {"ok", "network", "wifi", "bluetooth"}
            or reply["ok"] is not True):
        raise RuntimeError("Android radio state fields are not exact")
    network = reply["network"]
    if not isinstance(network, dict) or set(network) != {"state", "transports", "internetCapable", "validated"}:
        raise RuntimeError("Android network state fields are not exact")
    if type(network["state"]) is not str or network["state"] not in {"connected", "disconnected", "unknown"}:
        raise RuntimeError("Android network state is invalid")
    transports = network["transports"]
    if transports is not None:
        if (not isinstance(transports, list) or any(type(item) is not str or item not in RADIO_TRANSPORTS
                                                   for item in transports)
                or len(set(transports)) != len(transports)):
            raise RuntimeError("Android network transports are invalid")
    for key in ("internetCapable", "validated"):
        if network[key] is not None and type(network[key]) is not bool:
            raise RuntimeError("Android network capability is not boolean or null: " + key)
    if network["state"] == "disconnected":
        if transports != [] or network["internetCapable"] is not None or network["validated"] is not None:
            raise RuntimeError("Disconnected Android network state is inconsistent")
    elif network["state"] == "unknown":
        if transports is not None or network["internetCapable"] is not None or network["validated"] is not None:
            raise RuntimeError("Unknown Android network state is inconsistent")
    elif (not transports or network["internetCapable"] is None or network["validated"] is None):
        raise RuntimeError("Connected Android network state is incomplete")

    result = {"network": {key: network[key] for key in
                           ("state", "transports", "internetCapable", "validated")}}
    for key, states in (("wifi", WIFI_RADIO_STATES), ("bluetooth", BLUETOOTH_RADIO_STATES)):
        radio = reply[key]
        if not isinstance(radio, dict) or set(radio) != {"supported", "state"}:
            raise RuntimeError("Android " + key + " radio fields are not exact")
        supported = radio["supported"]
        state = radio["state"]
        if supported is not None and type(supported) is not bool:
            raise RuntimeError("Android " + key + " support flag is not boolean or null")
        if type(state) is not str or state not in states:
            raise RuntimeError("Android " + key + " radio state is invalid")
        if supported is False and state != "unsupported":
            raise RuntimeError("Unsupported Android " + key + " radio state is inconsistent")
        if supported is True and state == "unsupported":
            raise RuntimeError("Supported Android " + key + " radio is marked unsupported")
        if supported is None and state != "unknown":
            raise RuntimeError("Unknown Android " + key + " support has a known state")
        result[key] = {"supported": supported, "state": state}
    return result


class Portal:
    def __init__(self):
        self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.socket.settimeout(12)
        self.socket.connect(SOCKET)
        self.lock = threading.Lock()

    def read(self, size):
        if size < 0 or size > 16 * 1024 * 1024:
            raise RuntimeError("Invalid portal reply size")
        data = bytearray()
        while len(data) < size:
            part = self.socket.recv(size - len(data))
            if not part:
                raise ConnectionError("Android app portal disconnected")
            data.extend(part)
        return bytes(data)

    def request(self, op, **fields):
        data = json.dumps(dict(op=op, **fields)).encode()
        with self.lock:
            self.socket.sendall(struct.pack("!I", len(data)) + data)
            reply = json.loads(self.read(struct.unpack("!I", self.read(4))[0]))
            image = self.read(struct.unpack("!I", self.read(4))[0])
        if not reply.get("ok"):
            raise RuntimeError(reply.get("error", "Android app operation failed"))
        return reply, image

    def close(self):
        self.socket.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["list", "device-state", "battery-state", "radio-state", "display-settings",
                                           "network-settings", "bluetooth-settings", "sync", "open"])
    parser.add_argument("package", nargs="?")
    args = parser.parse_args()
    if args.package and args.action != "open":
        parser.error(f"{args.action} does not accept a target")
    portal = Portal()
    if args.action == "device-state":
        try:
            state = device_state(portal.request("device-state")[0])
            print(json.dumps(state, sort_keys=True))
        finally:
            portal.close()
        return
    if args.action == "battery-state":
        try:
            print(json.dumps(battery_state(portal.request("battery-state")[0]), sort_keys=True))
        finally:
            portal.close()
        return
    if args.action == "radio-state":
        try:
            print(json.dumps(radio_state(portal.request("radio-state")[0]), sort_keys=True))
        finally:
            portal.close()
        return
    if args.action == "display-settings":
        try:
            reply = portal.request("display-settings")[0]
            if reply.get("requested") is not True:
                raise RuntimeError("Android display settings request was not accepted")
            print("Android display settings requested")
        finally:
            portal.close()
        return
    if args.action in ("network-settings", "bluetooth-settings"):
        try:
            reply = portal.request(args.action)[0]
            if reply.get("requested") is not True:
                raise RuntimeError(f"Android {args.action} request was not accepted")
            label = "network" if args.action == "network-settings" else "Bluetooth"
            print(f"Android {label} settings requested")
        finally:
            portal.close()
        return
    if args.action in ("list", "sync"):
        apps = portal.request("list")[0]["apps"]
        if args.action == "list":
            print(json.dumps(apps, indent=2))
        else:
            applications = Path.home() / ".local/share/applications"
            print("Registered", sync_launchers(apps, applications), "Android app launchers")
        portal.close()
        return
    if not args.package:
        parser.error("open needs an installed Android package name")

    # Stock glibc GTK, not an Android overlay: Hyprland owns this xdg_toplevel's
    # position, workspace, tiling and size, exactly as for any Linux application.
    os.environ.setdefault("NO_AT_BRIDGE", "1")
    os.environ["GDK_BACKEND"] = "wayland"
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GdkPixbuf, GLib
    import cairo

    Gtk.init([])
    Gdk.set_program_class("omamobile-android")
    opened = portal.request("open", package=args.package, width=800, height=800)[0]
    print("Android app display", opened["display"], args.package, flush=True)
    window = Gtk.Window(title=args.package + " · Android")
    window.set_default_size(800, 800)
    drawing = Gtk.DrawingArea()
    drawing.set_can_focus(True)
    drawing.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.KEY_PRESS_MASK)
    window.add(drawing)
    state = dict(pixbuf=None, width=800, height=800, down=None, running=True, sequence=-1, resize=None)

    def draw(area, cr):
        pixbuf = state["pixbuf"]
        if pixbuf:
            cr.save()
            cr.scale(area.get_allocated_width() / pixbuf.get_width(), area.get_allocated_height() / pixbuf.get_height())
            Gdk.cairo_set_source_pixbuf(cr, pixbuf, 0, 0)
            cr.paint()
            cr.restore()
        return False

    def publish(image):
        if not state["running"]:
            return False
        loader = GdkPixbuf.PixbufLoader.new_with_type("jpeg")
        loader.write(image); loader.close()
        state["pixbuf"] = loader.get_pixbuf()
        drawing.queue_draw()
        return False

    def frames():
        while state["running"]:
            try:
                size = state.pop("resize", None)
                if size:
                    portal.request("resize", width=size[0], height=size[1])
                    state["width"], state["height"] = size
                reply, image = portal.request("frame", after=state["sequence"])
                state["sequence"] = reply["sequence"]
                if image:
                    GLib.idle_add(publish, image)
            except Exception as error:
                if state["running"]:
                    print(error, file=sys.stderr)
                break
            time.sleep(0.1)
        GLib.idle_add(window.destroy)

    def sized(area, rectangle):
        w, h = max(240, min(1920, rectangle.width)), max(240, min(1920, rectangle.height))
        if (w, h) != (state["width"], state["height"]):
            state["resize"] = (w, h)

    def point(event):
        return (max(0, min(state["width"] - 1, event.x * state["width"] / max(1, drawing.get_allocated_width()))),
                max(0, min(state["height"] - 1, event.y * state["height"] / max(1, drawing.get_allocated_height()))))

    def send(op, **fields):
        try:
            portal.request(op, **fields)
        except Exception as error:
            print(error, file=sys.stderr)

    def press(area, event):
        drawing.grab_focus()
        state["down"] = (*point(event), time.monotonic())
        return True

    def release(area, event):
        down = state["down"]
        state["down"] = None
        if down:
            x, y = point(event)
            send("gesture", x=down[0], y=down[1], endX=x, endY=y,
                 duration=max(50, min(1500, int((time.monotonic() - down[2]) * 1000))))
        return True

    def scroll(area, event):
        x, y = point(event)
        delta = -220 if event.direction == Gdk.ScrollDirection.DOWN else 220
        send("gesture", x=x, y=y, endX=x, endY=max(1, min(state["height"] - 2, y + delta)), duration=240)
        return True

    def key(area, event):
        name = Gdk.keyval_name(event.keyval)
        if name in ("Return", "BackSpace"):
            send("key", key=name)
        elif not event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK | Gdk.ModifierType.SUPER_MASK):
            char = Gdk.keyval_to_unicode(event.keyval)
            if char >= 32:
                send("key", text=chr(char))
        return True

    def destroy(*unused):
        state["running"] = False
        portal.close()
        Gtk.main_quit()

    drawing.connect("draw", draw)
    drawing.connect("size-allocate", sized)
    drawing.connect("button-press-event", press)
    drawing.connect("button-release-event", release)
    drawing.connect("scroll-event", scroll)
    window.connect("key-press-event", key)
    window.connect("destroy", destroy)
    window.show_all()
    threading.Thread(target=frames, daemon=True).start()
    Gtk.main()


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        print("Android windows: " + str(error).removeprefix("java.io.IOException: "), file=sys.stderr)
        raise SystemExit(1)
