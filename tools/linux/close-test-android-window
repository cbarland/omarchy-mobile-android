#!/bin/bash
set -euo pipefail
[[ $(hyprctl -j activewindow | jq -r .class) == omamobile-android ]]
hyprctl dispatch_lua_expression 'hl.dsp.window.close()'
for attempt in {1..50}; do
  hyprctl -j clients | jq -e 'any(.[]; .class == "omamobile-android")' >/dev/null || break
  sleep .1
done
! hyprctl -j clients | jq -e 'any(.[]; .class == "omamobile-android")' >/dev/null
