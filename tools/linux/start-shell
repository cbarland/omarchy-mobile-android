#!/bin/bash
set -euo pipefail
profile=${1:?phone, desktop or unified}
case $profile in phone|desktop|unified) ;; *) exit 64 ;; esac
export OMAMOBILE_PROFILE=$profile
export OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
export OMAMOBILE_SESSION_HOST=android
# Android accessibility integration is still pending. Avoid trying to activate
# a nonexistent Linux AT-SPI service before every GTK desktop-entry launch.
export NO_AT_BRIDGE=1
# Preserve the settings backend used by existing profiles. Native dconf now
# works through the credential adapter; migrating saved keyfile preferences
# remains separate from enabling that transport.
export GSETTINGS_BACKEND=${GSETTINGS_BACKEND:-keyfile}
export OMARCHY_SHELL_CONFIG=$HOME/.local/share/omamobile/profiles/$profile.json
export PATH=/usr/lib/omamobile/session-bin:$OMARCHY_PATH/bin:${PATH:-/usr/local/bin:/usr/bin:/bin}
export OMARCHY_STARTUP_BACKGROUND=$HOME/.local/state/omarchy/current/background
export QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1
# Android's Surface renderer owns GPU presentation. Standard Linux Qt clients
# initially send wl_shm buffers; neither client-side EGL nor a DRM device is required.
export QT_QPA_PLATFORM=wayland QT_QUICK_BACKEND=software QSG_RENDER_LOOP=basic
if [[ $profile == desktop ]] || ! command -v squeekboard >/dev/null; then
  [[ $profile == desktop ]] || echo 'Squeekboard is missing; prepare the Linux graphics packages to enable the phone keyboard.' >&2
  exec quickshell -n -p "$OMARCHY_PATH/shell"
fi
# Initialize missing defaults on session entry too: payload updates preserve user profiles
# and do not rerun first-install setup. Existing settings and layouts remain authoritative.
# Mobile's native input method and terminal controls; keep user choices intact.
python - <<'PY'
from gi.repository import Gio
settings = Gio.Settings.new('org.gnome.desktop.a11y.applications')
if settings.get_user_value('screen-keyboard-enabled') is None:
    settings.set_boolean('screen-keyboard-enabled', True)
    Gio.Settings.sync()
PY
keyboard_layout=${XDG_DATA_HOME:-$HOME/.local/share}/squeekboard/keyboards/terminal
if [[ ! -e $keyboard_layout/us.yaml && ! -L $keyboard_layout/us.yaml ]]; then
  mkdir -p "$keyboard_layout"
  ln -s /usr/share/omamobile/squeekboard/keyboards/terminal/us.yaml "$keyboard_layout/us.yaml"
fi
# Own both children so reopening a phone session cannot leave another OSK behind.
children=()
cleanup() {
  if (( ${#children[@]} )); then
    kill "${children[@]}" 2>/dev/null || true
    wait "${children[@]}" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
squeekboard &
children+=("$!")
quickshell -n -p "$OMARCHY_PATH/shell" &
children+=("$!")
wait "${children[1]}"
